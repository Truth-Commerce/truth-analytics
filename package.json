{
  "name": "truth-analytics",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "SaaS de inteligência de marketplace por IA — relatórios periódicos a partir do Bling (Truth Commerce)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:test": "node --env-file=.env.local --import tsx scripts/migrate-test.ts",
    "db:seed-admin": "node --env-file=.env.local --import tsx scripts/seed-admin.ts",
    "db:seed-analista": "node --env-file=.env.local --import tsx scripts/seed-analista.ts",
    "db:reencrypt": "node --env-file=.env.local --import tsx scripts/reencrypt-connections.ts",
    "db:purge-org": "node --env-file=.env.local --import tsx scripts/purge-org.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/functions": "^3.7.5",
    "bcryptjs": "^2.4.3",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.36.0",
    "framer-motion": "^11.18.2",
    "next": "^14.2.5",
    "next-auth": "5.0.0-beta.31",
    "postgres": "^3.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "resend": "^6.14.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.30.5",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.22.4",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
