POSTGRES_URL=
POSTGRES_URL_DIRECT=
# Override do tamanho do pool (scripts locais: seed, reencrypt). Padrão: 1 na Vercel, 4 local
# DB_POOL_MAX=
AUTH_SECRET=
APP_URL=http://localhost:3000
DATABASE_URL_TEST=
ENCRYPTION_KEY=
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=http://localhost:3000/api/connections/bling/callback
BLING_API_BASE=https://www.bling.com.br/Api/v3
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-opus-4-8
SERPAPI_KEY=
SERPAPI_BASE=https://serpapi.com
RESEND_API_KEY=
EMAIL_FROM=
# E-mail interno para alertas de falha no pipeline (padrão: EMAIL_FROM)
ADMIN_ALERT_EMAIL=
# Segredo compartilhado p/ autenticar POST interno em /api/pipeline/run (min 16 chars; gere com `openssl rand -hex 32`)
PIPELINE_SECRET=
# Segredo do Vercel Cron p/ autenticar GET /api/cron/watchdog (min 16 chars; a Vercel envia como `Authorization: Bearer ${CRON_SECRET}`)
CRON_SECRET=
# DSN do Sentry para captura de exceções (opcional; ausente = no-op)
